<?xml version="1.0" encoding="utf-8"?>
<!-- The wallet database lives under filesDir and must not leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
