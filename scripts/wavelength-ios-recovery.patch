new file mode 100644
index 0000000000000000000000000000000000000000..5214e1c4e6f5b6b3400de3ee5801d409f5ccdd06
--- /dev/null
+++ b/sdk/wavewalletdk/mobile/send_failure.go
@@ -0,0 +1,37 @@
+//go:build mobile && wavewalletrpc && swapruntime
+
+package mobile
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/lightninglabs/wavelength/sdk/wavewalletdk"
+)
+
+// sendRejectedPrefix marks only errors known to occur before dispatch. Other
+// errors must remain ambiguous until the host observes the accepted payment.
+const sendRejectedPrefix = "send rejected before dispatch"
+
+// rejectedSendError preserves the cause while exposing a stable host marker.
+func rejectedSendError(err error) error {
+	return fmt.Errorf("%s: %w", sendRejectedPrefix, err)
+}
+
+// classifySendError identifies the SDK's pre-dispatch admission rejections. A
+// timeout, cancellation, or untyped backend error is deliberately not cleared.
+func classifySendError(err error) error {
+	for _, rejection := range []error{
+		wavewalletdk.ErrInvalidSendIntent,
+		wavewalletdk.ErrSwapBackendUnavailable,
+		wavewalletdk.ErrInvalidDestination,
+		wavewalletdk.ErrAmountRequired,
+		wavewalletdk.ErrAmountInvalid,
+	} {
+		if errors.Is(err, rejection) {
+			return rejectedSendError(err)
+		}
+	}
+
+	return err
+}
diff --git a/sdk/wavewalletdk/mobile/send_failure_test.go b/sdk/wavewalletdk/mobile/send_failure_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3b7fe0c9d22189ac4f511affe95d85b0c13c2557
--- /dev/null
+++ b/sdk/wavewalletdk/mobile/send_failure_test.go
@@ -0,0 +1,50 @@
+//go:build mobile && wavewalletrpc && swapruntime
+
+package mobile
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/lightninglabs/wavelength/sdk/wavewalletdk"
+	"github.com/stretchr/testify/require"
+)
+
+// TestSendFailureKeepsAmbiguousOutcomes separates expired quotes from failures
+// that may follow acceptance, so a host cannot silently enable duplicate sends.
+func TestSendFailureKeepsAmbiguousOutcomes(t *testing.T) {
+	t.Parallel()
+
+	for _, cause := range []error{
+		wavewalletdk.ErrInvalidSendIntent,
+		wavewalletdk.ErrSwapBackendUnavailable,
+		wavewalletdk.ErrInvalidDestination,
+		wavewalletdk.ErrAmountRequired,
+		wavewalletdk.ErrAmountInvalid,
+	} {
+		err := classifySendError(fmt.Errorf("send: %w", cause))
+		require.True(
+			t,
+			strings.HasPrefix(
+				err.Error(), sendRejectedPrefix,
+			),
+		)
+		require.ErrorIs(t, err, cause)
+	}
+	for _, cause := range []error{
+		context.DeadlineExceeded, context.Canceled,
+		errors.New("backend response lost"),
+	} {
+		err := classifySendError(cause)
+		require.ErrorIs(t, err, cause)
+		require.False(
+			t,
+			strings.HasPrefix(
+				err.Error(), sendRejectedPrefix,
+			),
+		)
+	}
+}
