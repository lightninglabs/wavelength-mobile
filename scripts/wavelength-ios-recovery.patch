diff --git a/sdk/wavewalletdk/client_exit_fee_mobile.go b/sdk/wavewalletdk/client_exit_fee_mobile.go
new file mode 100644
index 0000000000000000000000000000000000000000..753f06bb8b1e106511e84ca5f109f57c7f30fb43
--- /dev/null
+++ b/sdk/wavewalletdk/client_exit_fee_mobile.go
@@ -0,0 +1,99 @@
+package wavewalletdk
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/btcsuite/btcd/btcutil/v2"
+	"github.com/lightninglabs/wavelength/waverpc"
+)
+
+// ExitFeeEstimate is an advisory cooperative-leave estimate for one exact
+// Bitcoin VTXO. The binding round quote remains authoritative at execution.
+type ExitFeeEstimate struct {
+	Outpoint         string
+	AmountSat        int64
+	EstimatedFeeSat  int64
+	BelowDustWarning bool
+}
+
+// EstimateExitFee reads the selected VTXO and current chain tip, then asks the
+// operator to price its forfeiture. It never queues an exit or allocates an
+// address. In particular, a pure-refresh waiver cannot make a leave look free.
+func (c *Client) EstimateExitFee(ctx context.Context, outpoint string) (
+	*ExitFeeEstimate, error) {
+
+	if err := c.requireWalletRPC(); err != nil {
+		return nil, err
+	}
+	if outpoint == "" {
+		return nil, fmt.Errorf("outpoint is required")
+	}
+
+	inventory, err := c.daemon.ListVTXOs(ctx, &waverpc.ListVTXOsRequest{
+		StatusFilter:           waverpc.VTXOStatus_VTXO_STATUS_LIVE,
+		ExcludeCheckpointPsbts: true,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("read exit funds: %w", err)
+	}
+	var selected *waverpc.VTXO
+	for _, v := range inventory.GetVtxos() {
+		if v.GetOutpoint() == outpoint && v.GetAssetRef() == "" &&
+			v.GetStatus() == waverpc.VTXOStatus_VTXO_STATUS_LIVE {
+
+			selected = v
+			break
+		}
+	}
+	if selected == nil {
+		return nil, fmt.Errorf("selected exit funds are no longer " +
+			"available")
+	}
+	info, err := c.daemon.GetInfo(ctx, &waverpc.GetInfoRequest{})
+	if err != nil {
+		return nil, fmt.Errorf("read exit chain tip: %w", err)
+	}
+	if info.GetBlockHeight() == 0 || selected.GetBatchExpiry() <= 0 {
+		return nil, fmt.Errorf("exit fee needs a current tip and " +
+			"known expiry")
+	}
+
+	// Zero means full lifetime to the operator. Clamp near-expiry funds to
+	// one block instead of accidentally pricing a fresh lifetime.
+	remaining := int64(selected.GetBatchExpiry()) -
+		int64(info.GetBlockHeight())
+	if remaining < 1 {
+		remaining = 1
+	}
+	quote, err := c.daemon.EstimateFee(ctx, &waverpc.EstimateFeeRequest{
+		AmountSat:       selected.GetAmountSat(),
+		IsBoarding:      false,
+		RemainingBlocks: uint32(remaining),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("estimate exit fee: %w", err)
+	}
+
+	// The quote components must agree with the displayed total. Bounding
+	// each component also makes their sum safe from signed overflow.
+	var sum int64
+	for _, component := range []int64{
+		quote.GetLiquidityFeeSat(), quote.GetOnchainShareSat(),
+		quote.GetMarginSat(),
+	} {
+		if component < 0 || component > int64(btcutil.MaxSatoshi) {
+			return nil, fmt.Errorf("invalid exit fee estimate")
+		}
+		sum += component
+	}
+	if sum != quote.GetTotalFeeSat() || sum > int64(btcutil.MaxSatoshi) {
+		return nil, fmt.Errorf("invalid exit fee estimate")
+	}
+
+	return &ExitFeeEstimate{
+		Outpoint: outpoint, AmountSat: selected.GetAmountSat(),
+		EstimatedFeeSat:  quote.GetTotalFeeSat(),
+		BelowDustWarning: quote.GetBelowDustWarning(),
+	}, nil
+}
diff --git a/sdk/wavewalletdk/client_exit_fee_mobile_test.go b/sdk/wavewalletdk/client_exit_fee_mobile_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cd43f3cd18f7721ff44f5c62d505a088dd7431aa
--- /dev/null
+++ b/sdk/wavewalletdk/client_exit_fee_mobile_test.go
@@ -0,0 +1,146 @@
+package wavewalletdk
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/lightninglabs/wavelength/waverpc"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+)
+
+// exitFeeDaemon implements reads only; any attempt to queue funds fails loudly.
+type exitFeeDaemon struct {
+	waverpc.DaemonServiceClient
+	vtxos    []*waverpc.VTXO
+	height   uint32
+	quote    *waverpc.EstimateFeeResponse
+	quoteErr error
+	request  *waverpc.EstimateFeeRequest
+}
+
+// ListVTXOs returns the locally owned selected input without artifact loading.
+func (d *exitFeeDaemon) ListVTXOs(_ context.Context,
+	req *waverpc.ListVTXOsRequest, _ ...grpc.CallOption) (
+	*waverpc.ListVTXOsResponse, error) {
+
+	return &waverpc.ListVTXOsResponse{Vtxos: d.vtxos}, nil
+}
+
+// GetInfo returns the tip used to price remaining lifetime.
+func (d *exitFeeDaemon) GetInfo(context.Context, *waverpc.GetInfoRequest,
+	...grpc.CallOption) (*waverpc.GetInfoResponse, error) {
+
+	return &waverpc.GetInfoResponse{BlockHeight: d.height}, nil
+}
+
+// EstimateFee records the exact selected amount and forfeit lifetime.
+func (d *exitFeeDaemon) EstimateFee(_ context.Context,
+	req *waverpc.EstimateFeeRequest, _ ...grpc.CallOption) (
+	*waverpc.EstimateFeeResponse, error) {
+
+	d.request = req
+
+	return d.quote, d.quoteErr
+}
+
+// TestExitFeePricesSelectedFunds verifies read-only pricing uses authoritative
+// inventory and never applies the free-refresh waiver to cooperative leave.
+func TestExitFeePricesSelectedFunds(t *testing.T) {
+	t.Parallel()
+	d := &exitFeeDaemon{
+		vtxos: []*waverpc.VTXO{
+			{
+				Outpoint:  "other:0",
+				AmountSat: 9000,
+			},
+			{
+				Outpoint:    "selected:1",
+				AmountSat:   8000,
+				BatchExpiry: 102,
+				Status: waverpc.
+					VTXOStatus_VTXO_STATUS_LIVE,
+			},
+		},
+		height: 100,
+		quote: &waverpc.EstimateFeeResponse{
+			LiquidityFeeSat: 3, OnchainShareSat: 4, MarginSat: 5,
+			TotalFeeSat: 12,
+		},
+	}
+	c := &Client{canWallet: true, daemon: d}
+	result, err := c.EstimateExitFee(t.Context(), "selected:1")
+	require.NoError(t, err)
+	require.EqualValues(t, 8000, result.AmountSat)
+	require.EqualValues(t, 12, result.EstimatedFeeSat)
+	require.EqualValues(t, 8000, d.request.AmountSat)
+	require.EqualValues(t, 2, d.request.RemainingBlocks)
+	require.False(t, d.request.IsBoarding)
+
+	// Near expiry must not send zero, which means a fresh full lifetime.
+	d.height = 102
+	_, err = c.EstimateExitFee(t.Context(), "selected:1")
+	require.NoError(t, err)
+	require.EqualValues(t, 1, d.request.RemainingBlocks)
+	// A genuine zero quote remains distinct from a failed lookup.
+	d.quote = &waverpc.EstimateFeeResponse{}
+	result, err = c.EstimateExitFee(t.Context(), "selected:1")
+	require.NoError(t, err)
+	require.Zero(t, result.EstimatedFeeSat)
+}
+
+// TestExitFeeFailuresNeverBecomeFree rejects unavailable facts and invalid
+// quotes instead of emitting a numeric zero estimate.
+func TestExitFeeFailuresNeverBecomeFree(t *testing.T) {
+	t.Parallel()
+	for _, name := range []string{
+		"unknown", "spent", "asset", "noexpiry", "notip",
+		"offline", "invalid",
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := &exitFeeDaemon{
+				vtxos: []*waverpc.VTXO{{
+					Outpoint:    "selected:1",
+					AmountSat:   8000,
+					BatchExpiry: 200,
+					Status: waverpc.
+						VTXOStatus_VTXO_STATUS_LIVE,
+				}},
+				height: 100,
+				quote:  &waverpc.EstimateFeeResponse{},
+			}
+			switch name {
+			case "unknown":
+				d.vtxos = nil
+
+			case "spent":
+				d.vtxos[0].Status =
+					waverpc.VTXOStatus_VTXO_STATUS_SPENT
+
+			case "asset":
+				d.vtxos[0].AssetRef = "asset"
+
+			case "noexpiry":
+				d.vtxos[0].BatchExpiry = 0
+
+			case "notip":
+				d.height = 0
+
+			case "offline":
+				d.quoteErr = errors.New("operator unavailable")
+
+			case "invalid":
+				d.quote.TotalFeeSat = -1
+			}
+			result, err := (&Client{
+				canWallet: true,
+				daemon:    d,
+			}).EstimateExitFee(
+				t.Context(), "selected:1",
+			)
+			require.Error(t, err)
+			require.Nil(t, result)
+		})
+	}
+}
