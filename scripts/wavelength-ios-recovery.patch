@@ -0,0 +1,88 @@
+//go:build mobile && wavewalletrpc && swapruntime
+
+package mobile
+
+import "github.com/lightninglabs/wavelength/sdk/wavewalletdk"
+
+// Refresh previews or queues reissuance of selected VTXOs. The JSON request and
+// response use wavewalletdk.RefreshRequest and wavewalletdk.RefreshResult.
+func Refresh(reqJSON []byte) ([]byte, error) {
+	client, ctx, err := activeClient()
+	if err != nil {
+		return nil, err
+	}
+
+	var req wavewalletdk.RefreshRequest
+	if err := decode(reqJSON, &req); err != nil {
+		return nil, err
+	}
+
+	res, err := client.Refresh(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+
+	return marshal(res)
+}
+
+// ExportExits returns the complete portable recovery JSON for Outpoints from a
+// JSON object. This does not broadcast transactions or start recovery jobs.
+func ExportExits(reqJSON []byte) ([]byte, error) {
+	client, parent, err := activeClient()
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := readContext(parent)
+	defer cancel()
+
+	var req struct {
+		Outpoints []string
+	}
+	if err := decode(reqJSON, &req); err != nil {
+		return nil, err
+	}
+
+	return client.ExportExitsJSON(ctx, req.Outpoints)
+}
+
+// ObserveRefresh reports confirmed settlement of the exact selected inputs.
+func ObserveRefresh(reqJSON []byte) ([]byte, error) {
+	client, parent, err := activeClient()
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := readContext(parent)
+	defer cancel()
+
+	var req struct {
+		Outpoints []string
+	}
+	if err := decode(reqJSON, &req); err != nil {
+		return nil, err
+	}
+
+	res, err := client.ObserveRefresh(ctx, req.Outpoints)
+	if err != nil {
+		return nil, err
+	}
+
+	return marshal(res)
+}
+
+// RecoveryInventory returns Bitcoin funds not already forfeited or spent,
+// including expired funds and records already exiting on-chain.
+func RecoveryInventory() ([]byte, error) {
+	client, parent, err := activeClient()
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := readContext(parent)
+	defer cancel()
+
+	res, err := client.RecoveryInventory(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	return marshal(res)
+}
diff --git a/sdk/wavewalletdk/mobile/send_failure.go b/sdk/wavewalletdk/mobile/send_failure.go
new file mode 100644
index 00000000..5214e1c4
--- /dev/null
+++ b/sdk/wavewalletdk/mobile/send_failure.go
@@ -0,0 +1,37 @@
+//go:build mobile && wavewalletrpc && swapruntime
+
+package mobile
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/lightninglabs/wavelength/sdk/wavewalletdk"
+)
+
+// sendRejectedPrefix marks only errors known to occur before dispatch. Other
+// errors must remain ambiguous until the host observes the accepted payment.
+const sendRejectedPrefix = "send rejected before dispatch"
+
+// rejectedSendError preserves the cause while exposing a stable host marker.
+func rejectedSendError(err error) error {
+	return fmt.Errorf("%s: %w", sendRejectedPrefix, err)
+}
+
+// classifySendError identifies the SDK's pre-dispatch admission rejections. A
+// timeout, cancellation, or untyped backend error is deliberately not cleared.
+func classifySendError(err error) error {
+	for _, rejection := range []error{
+		wavewalletdk.ErrInvalidSendIntent,
+		wavewalletdk.ErrSwapBackendUnavailable,
+		wavewalletdk.ErrInvalidDestination,
+		wavewalletdk.ErrAmountRequired,
+		wavewalletdk.ErrAmountInvalid,
+	} {
+		if errors.Is(err, rejection) {
+			return rejectedSendError(err)
+		}
+	}
+
+	return err
+}
diff --git a/sdk/wavewalletdk/mobile/send_failure_test.go b/sdk/wavewalletdk/mobile/send_failure_test.go
